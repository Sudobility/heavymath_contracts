{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "outDir": "dist/unified",
    "noEmit": false,
    "jsx": "react",
    "rootDir": "./src"
  },
  "include": [
    "src/unified/**/*",
    "src/utils/**/*",
    "src/evm/**/*",
    "src/solana/**/*",
    "src/react/**/*"
  ],
  "exclude": ["node_modules", "dist", "test/**/*", "target/types/**/*"]
}
